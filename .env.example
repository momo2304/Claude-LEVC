# Which site to run: cabs (Reverie Cab Sales) or chauffeur (Reverie Executive)
SITE=cabs

# Public URL of the site (used in emails, sitemap, canonical links)
SITE_URL=https://cabs.reverieautos.co.uk
PORT=3000
DB_PATH=            # default data/<site>-leads.db

# Shown on the site only when set. Not verified by us: fill in before launch.
SALES_PHONE=
SALES_PUBLIC_EMAIL=

# Finance pages and copy stay hidden until this is set (FCA rules on credit promotions).
# Example: Reverie Autos Ltd is authorised and regulated by the Financial Conduct Authority (FRN XXXXXX). We are a credit broker, not a lender.
FCA_STATEMENT=

# Call booking
SALES_REPS=2            # calls that can run in the same slot
SLOT_MINUTES=20
LEAD_TIME_MINUTES=120   # earliest bookable call from now
DAYS_AHEAD=14
CLOSED_DATES=2026-12-25,2026-12-26,2026-12-28,2027-01-01

# Sales team alerts (any or all)
SALES_WEBHOOK_URL=      # Zapier/Make/n8n hook -> HubSpot, Pipedrive, Slack, Google Sheets
RESEND_API_KEY=         # https://resend.com - booking emails with calendar invites
FROM_EMAIL=             # verified sender, e.g. bookings@reverieautos.co.uk
SALES_EMAILS=           # comma-separated, e.g. sales1@...,sales2@...

# Sales dashboard at /admin (disabled until a password is set)
ADMIN_USER=sales
ADMIN_PASSWORD=
